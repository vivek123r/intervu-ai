ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=intervu

# "mock" accepts exactly "demo-token" and resolves the seeded demo user.
# Switch to "firebase" once you're testing real sign-in.
AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Calendar OAuth — empty means the connect flow runs in mocked mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly

APP_ENCRYPTION_KEY=development-only-change-me
OAUTH_STATE_SECRET=development-oauth-state-change-me

# AI Provider — "mock" runs deterministically without network calls.
# Switch to "openrouter" to use DeepSeek or other OpenRouter models.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=false

# Coding Judge (Piston)
PISTON_BASE_URL=http://localhost:2000/api/v2
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_RUN_TIMEOUT_MS=20000
JUDGE_MEMORY_LIMIT_BYTES=536870912
MAX_TESTCASES_PER_RUN=5
MAX_CODE_LENGTH=65536
