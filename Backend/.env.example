ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=intervu

# "mock" accepts exactly "demo-token" and resolves the seeded demo user.
# Switch to "firebase" once you're testing real sign-in.
AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Calendar OAuth — empty means the connect flow runs in mocked mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly

APP_ENCRYPTION_KEY=development-only-change-me
OAUTH_STATE_SECRET=development-oauth-state-change-me

# AI Provider — "openrouter" connects to OpenRouter LLMs (DeepSeek, Gemini, etc.)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads
MAX_UPLOAD_MB=10
# Bounds the LLM- and TTS-backed endpoints (report chat, /voice/tts, session
# creation) per bearer token. Off by default so local development isn't throttled.
RATE_LIMIT_ENABLED=false

# How long a practice session's raw transcripts and interviewer log are kept.
# The report derived from them is never expired. 0 disables expiry.
PRACTICE_SESSION_RETENTION_DAYS=90

# Coding Judge (Piston)
PISTON_BASE_URL=http://localhost:2000/api/v2
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_RUN_TIMEOUT_MS=20000
JUDGE_MEMORY_LIMIT_BYTES=536870912
MAX_TESTCASES_PER_RUN=5
MAX_CODE_LENGTH=65536
