# Browser-safe Next.js environment values — see Backend/.env.example for the API side.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# "mock" sends a fixed "demo-token" the backend's AUTH_MODE=mock resolves to a demo user.
# Production must use "firebase" with real project credentials below.
NEXT_PUBLIC_AUTH_MODE=mock

# When set to "enabled", MSW intercepts all API/WebSocket traffic in the browser and
# serves src/mocks fixtures instead of NEXT_PUBLIC_API_URL/NEXT_PUBLIC_WS_URL — useful
# for frontend-only work with no backend running. Leave unset to hit a real backend.
# NEXT_PUBLIC_API_MOCKING=enabled

# Gates onboarding/demo-only UI copy — unrelated to API mocking above.
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
