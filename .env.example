ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://intervu:intervu@postgres:5432/intervu
REDIS_URL=redis://redis:6379/0

# Authentication. Production must use firebase.
AUTH_MODE=mock
NEXT_PUBLIC_AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Separate Google Calendar OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# Replace in staging/production. Tokens are never sent to the browser.
APP_ENCRYPTION_KEY=development-only-change-me
OAUTH_STATE_SECRET=development-oauth-state-change-me

# AI boots in deterministic mock mode without an API key.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
AI_MODEL_INTERVIEW=
AI_MODEL_ANALYSIS=
AI_MODEL_PREPARATION=
AI_MODEL_CLASSIFICATION=

# Files and limits
FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true

# Frontend demo behavior
NEXT_PUBLIC_DEMO_MODE=true
