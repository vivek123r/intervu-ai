# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (separate repository — see docs/API-CONTRACT.md)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Authentication. "mock" issues a deterministic demo principal; production must use "firebase".
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# When enabled, MSW intercepts all API/WebSocket traffic in the browser and serves
# src/mocks fixtures instead of NEXT_PUBLIC_API_URL/NEXT_PUBLIC_WS_URL. Turn this off
# once the backend in docs/API-CONTRACT.md is deployed and reachable.
NEXT_PUBLIC_API_MOCKING=enabled

# Frontend demo behavior (unrelated to API mocking — gates onboarding/demo-only UI copy)
NEXT_PUBLIC_DEMO_MODE=true
