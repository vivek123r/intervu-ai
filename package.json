{
  "name": "intervu-ai",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @intervu/web --filter @intervu/shared-types dev",
    "dev:web": "pnpm --filter @intervu/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
